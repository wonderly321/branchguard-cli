{
  "name": "@sonori/branchguard-cli",
  "version": "0.1.0",
  "description": "Lightweight Git merge conflict pre-check CLI.",
  "type": "module",
  "homepage": "https://github.com/wonderly321/branchguard-cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wonderly321/branchguard-cli.git"
  },
  "bugs": {
    "url": "https://github.com/wonderly321/branchguard-cli/issues"
  },
  "bin": {
    "branchguard": "bin/branchguard.mjs"
  },
  "files": [
    "bin/",
    "docs/",
    "scripts/",
    ".branchguard.json",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "node --check ./bin/branchguard.mjs && node --check ./test/branchguard.test.mjs",
    "prepack": "npm run check && npm test",
    "publish:beta:win": "powershell -ExecutionPolicy Bypass -File ./scripts/publish-beta.ps1",
    "start": "node ./bin/branchguard.mjs",
    "test": "node --test"
  },
  "keywords": [
    "git",
    "merge",
    "conflict",
    "cli",
    "pre-merge",
    "branch",
    "ci"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=20"
  }
}
